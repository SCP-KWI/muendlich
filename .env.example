# Copy to .env and fill in. Used by docker-compose.
# Generate both secrets with:  openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=

# Stage 2 provider: stub (no key, default) | anthropic
AI_PROVIDER=stub
ANTHROPIC_API_KEY=

# Local pseudonymization before any cloud call. Leave true.
# With AI_PROVIDER=anthropic the backend refuses to start if this is false,
# unless you also set ALLOW_CLOUD_PII=true (needs a data processing agreement).
ANONYMIZE_ENABLED=true

# PWA origin(s) allowed by CORS, comma-separated
CORS_ORIGINS=http://localhost:5173

# Shareable demo: logging in with DEMO_EMAIL creates a private, time-boxed copy
# of the app with sample data. Off by default; see deploy/.env.example for the
# spending caps and README.md for what it does.
DEMO_ENABLED=false
DEMO_PASSWORD=
