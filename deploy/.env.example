# Copy to .env on the server and fill in. Never commit the real .env.
# Generate both secrets with:  openssl rand -hex 32
# JWT_SECRET must be >= 32 characters; the backend refuses to start otherwise.
DB_PASSWORD=
JWT_SECRET=

# Stage 2 cloud model
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
STRUCTURER_MODEL=claude-sonnet-4-6
# Per-attempt HTTP timeout for the structurer call, in seconds.
STRUCTURER_TIMEOUT_S=30

DEFAULT_TZ=Europe/Zurich

# Public HTTPS origin of the app, as reached through your reverse proxy.
# Required: this is what CORS allows and what the PWA is served from.
APP_ORIGIN=https://app.example.com

# Name of the existing Docker network your reverse proxy is attached to, so the
# `web` container can be reached by name. Find it with `docker network ls`
# (NGINX Proxy Manager's stock compose file creates `nginxproxymanager_default`).
PROXY_NETWORK=

# Local pseudonymization: student names are replaced with placeholders (roster +
# first-name gazetteer + German spaCy NER) BEFORE the text is sent to the cloud,
# and restored locally afterwards. The image bakes in the spaCy model.
#
# Leave this true. With AI_PROVIDER=anthropic the backend REFUSES TO START when
# it is false, unless ALLOW_CLOUD_PII=true is also set — and sending identifiable
# pupil data to a third country needs a data processing agreement first.
#
# Note this is pseudonymization, not anonymization: the behavioural content still
# leaves the building, and placeholders map back to real names locally.
ANONYMIZE_ENABLED=true

# Verbatim dictations are cleared at commit time; this bounds how long an
# abandoned or failed capture survives. Enforced by `python -m app.purge`.
RAW_CAPTURE_RETENTION_DAYS=30
